<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Apis.Sheets.v4" Version="1.75.0.4178" />
  </ItemGroup>

  <ItemGroup>
    <!-- Garante que o credentials.json vai sempre para a pasta de publicação (o token_store fica
         de fora de propósito: cada ambiente deve manter o seu próprio token já autenticado). -->
    <None Include="credentials.json" CopyToPublishDirectory="PreserveNewest" Condition="Exists('credentials.json')" />
  </ItemGroup>

</Project>
