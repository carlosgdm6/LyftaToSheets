@page "/"
@using LyftaToSheets.Models
@using LyftaToSheets.Services
@inject ImportService Import
@inject MesocicloService Mesociclo
@inject LyftaTokenService LyftaToken
@inject ILogger<Registo> Log
@inject IJSRuntime JS
@rendermode InteractiveServer
@implements IAsyncDisposable

<PageTitle>LyftaSync</PageTitle>

<script>
    // Helper simples e global (não é module) só para centrar a coluna da semana atual
    // quando o modal "Visão geral" abre — chamado via JS interop a partir do bloco @@code.
    window.lyftaSyncFocar = function (id) {
        var el = document.getElementById(id);
        if (el) el.scrollIntoView({ inline: 'center', block: 'nearest' });
    };
</script>

<div class="top-actions">
    <button class="icon-btn visao-btn" title="Visão geral das semanas" @onclick="AbrirVisaoGeralAsync"><i class="fa-solid fa-table-cells"></i></button>
    <button class="icon-btn gear-btn" title="Definições" @onclick="() => _definicoesAbertas = true"><i class="fa-solid fa-gear"></i></button>
</div>

@* ============ HERO ============ *@
@if (_fase == Fase.Hero)
{
    <div class="hero">
        <h1 class="hero-title"><i class="fa-solid fa-bolt"></i> Lyfta<span class="accent">Sync</span></h1>
        <p class="hero-flowline">Lyfta <span class="arrow"><i class="fa-solid fa-arrow-right"></i></span> Sheets</p>

        <div class="cta-wrap">
            <button class="cta @(_ocupado ? "loading" : "")" @onclick="IniciarAsync" disabled="@_ocupado">
                @if (_ocupado)
                {
                    <span class="cta-spinner"></span>
                    <span>A ligar…</span>
                }
                else
                {
                    <span class="ico">
                        @if (_temTokenGuardado)
                        {
                            <i class="fa-solid fa-magnifying-glass"></i>
                        }
                        else
                        {
                            <i class="fa-brands fa-google"></i>
                        }
                    </span>
                    <span>@(_temTokenGuardado ? "Sincronizar" : "Ligar ao Google")</span>
                }
            </button>
            @if (!_temTokenGuardado && !_ocupado)
            {
                <span class="cta-hint">Abre a tua conta Google.</span>
            }
        </div>
    </div>
}

@* ============ A CARREGAR ============ *@
@if (_fase == Fase.Carregando)
{
    <div class="carregando">
        <div class="cta-spinner grande"></div>
        <p>A verificar os teus treinos mais recentes…</p>
    </div>
}

@* ============ CONFIRMAÇÃO — mostra o que vai ser escrito antes de escrever ============ *@
@if (_fase == Fase.Confirmacao)
{
    <div class="confirm-stage">
        @if (_previews is { Count: 0 })
        {
            <div class="vazio-card">
                <span class="vazio-icon"><i class="fa-solid fa-circle-check"></i></span>
                <h3>Tudo em dia</h3>
                <p>Não há treinos novos do Lyfta por sincronizar.</p>
                <button class="btn btn-ghost" @onclick="Voltar">Voltar</button>
            </div>
        }
        else if (_previews is not null)
        {
            <h2 class="confirm-title">Pronto para sincronizar @_previews.Count treino@(_previews.Count == 1 ? "" : "s")</h2>
            <p class="confirm-sub">Confirma antes de escrever na folha do coach.</p>

            <div class="preview-list">
                @foreach (var p in _previews)
                {
                    <div class="preview-card">
                        <PreviewTreinoCard Preview="p" Meta="@($"Treino de {FormatarData(p.DataLyfta)} · {p.Linhas.Count} exercício{(p.Linhas.Count == 1 ? "" : "s")}")" />
                    </div>
                }
            </div>

            <div class="confirm-actions">
                <button class="btn btn-ghost" @onclick="Voltar" disabled="@_ocupado">Cancelar</button>
                <button class="btn btn-primario" @onclick="ConfirmarEGravarAsync" disabled="@_ocupado">
                    Confirmar e escrever @_previews.Count treino@(_previews.Count == 1 ? "" : "s")
                </button>
            </div>
        }
    </div>
}

@* ============ A GRAVAR ============ *@
@if (_fase == Fase.AGravar && _previews is not null)
{
    <div class="gravar-stage">
        <h2 class="confirm-title">A escrever na folha…</h2>
        <div class="preview-list">
            @foreach (var p in _previews)
            {
                var gravado = _gravados.Contains(p.Nome);
                var ativo = _aGravarNome == p.Nome;
                <div class="preview-card @(ativo ? "ativo" : "") @(gravado ? "concluido" : "")">
                    <div class="preview-head">
                        <span class="preview-nome">@p.Nome</span>
                        <span class="preview-status">
                            @if (gravado)
                            {
                                <span class="ok-inline"><i class="fa-solid fa-check"></i> gravado</span>
                            }
                            else if (ativo)
                            {
                                <span class="mini-spin"></span>
                            }
                        </span>
                    </div>
                    <div class="preview-meta">Semana @p.Semana</div>
                </div>
            }
        </div>
    </div>
}

@* ============ CONCLUÍDO ============ *@
@if (_fase == Fase.Concluido)
{
    <div class="sucesso">
        <div class="sucesso-check"><i class="fa-solid fa-check"></i></div>
        <h2>Está feito.</h2>
        @if (_previews is { Count: > 0 })
        {
            <p>@_previews.Count treino@(_previews.Count == 1 ? "" : "s") sincronizado@(_previews.Count == 1 ? "" : "s").</p>
            <span class="semana-tag">Semana @_previews.Max(p => p.Semana)</span>
        }
        <div class="confirm-actions" style="margin-top:22px">
            <button class="btn btn-primario" @onclick="() => EntrarDashboardAsync(_gravadosNesteSync)">Continuar</button>
        </div>
    </div>
}

@* ============ ERRO ============ *@
@if (_fase == Fase.Erro)
{
    <div class="erro-card">
        <div class="erro-ico"><i class="fa-solid fa-triangle-exclamation"></i></div>
        <h3>Não foi possível sincronizar</h3>
        <p>@_erro</p>
        <button class="btn btn-primario" @onclick="TentarNovamente">Tentar novamente</button>
    </div>
}

@* ============ DASHBOARD ============ *@
@if (_fase == Fase.Dashboard)
{
    <div class="dash-top">
        <h1>Tudo sincronizado.</h1>
        <div class="quando"><span class="dot"><i class="fa-solid fa-circle"></i></span> Última sincronização · @TempoDesde()</div>
    </div>

    <div class="stat-grid">
        <div class="stat-tile">
            <div class="stat-num">@_treinosSincronizadosSessao</div>
            <div class="stat-label">Treinos sincronizados</div>
        </div>
        <div class="stat-tile">
            <div class="stat-num">@_semanaMaisAlta</div>
            <div class="stat-label">Semanas preenchidas</div>
        </div>
        <div class="stat-tile">
            <div class="stat-num check"><i class="fa-solid fa-check"></i></div>
            <div class="stat-label">Google ligado</div>
        </div>
    </div>

    <div class="next-card">
        @if (_aCarregarProxima)
        {
            <div class="cta-spinner" style="margin:0 auto"></div>
        }
        else if (_proximaPrevia is { Count: > 0 })
        {
            <div class="kicker">Próxima sincronização</div>
            <h3>Semana @_proximaPrevia.Min(p => p.Semana)</h3>
            <p>@_proximaPrevia.Count treino@(_proximaPrevia.Count == 1 ? "" : "s") pronto@(_proximaPrevia.Count == 1 ? "" : "s")</p>
            <button class="btn btn-primario" @onclick="VerProximaSincronizacaoAsync">Ver e sincronizar</button>
        }
        else
        {
            <span class="vazio-icon"><i class="fa-solid fa-circle-check"></i></span>
            <h3>Tudo em dia</h3>
            <p>Faz o próximo treino no Lyfta e volta aqui.</p>
            <button class="btn btn-ghost" @onclick="CarregarPreviewAsync">Verificar de novo</button>
        }
    </div>
}

@* ============ DRAWER DE DEFINIÇÕES ============ *@
<div class="drawer-backdrop @(_definicoesAbertas ? "aberto" : "")" @onclick="() => _definicoesAbertas = false"></div>
<aside class="drawer @(_definicoesAbertas ? "aberto" : "")">
    <div class="drawer-head">
        <h3 class="drawer-title">Definições</h3>
        <button class="drawer-close" @onclick="() => _definicoesAbertas = false"><i class="fa-solid fa-xmark"></i></button>
    </div>

    <section class="drawer-section">
        <h4 class="drawer-section-title">Ligação ao Google</h4>
        <div class="drawer-field">
            <button class="btn btn-ghost btn-block" @onclick="TestarGoogleAsync" disabled="@_testandoGoogle">
                @(_testandoGoogle ? "A testar…" : "Testar ligação")
            </button>
            @if (_googleTesteOk == true)
            {
                <span class="status-pill ok"><i class="fa-solid fa-check"></i> ligado</span>
            }
            @if (_googleTesteOk == false)
            {
                <span class="status-pill erro"><i class="fa-solid fa-xmark"></i> falhou</span>
            }
        </div>
    </section>

    <section class="drawer-section">
        <h4 class="drawer-section-title">Token da API do Lyfta</h4>
        <a class="btn btn-ghost btn-block" href="https://my.lyfta.app/community/api" target="_blank" rel="noopener noreferrer">
            Obter token no Lyfta <i class="fa-solid fa-arrow-up-right-from-square"></i>
        </a>
        <input class="token-input" type="text" placeholder="Cola aqui o novo token" @bind="_novoToken" @bind:event="oninput" />
        <div class="drawer-field">
            <button class="btn btn-primario btn-block" @onclick="RenovarTokenAsync" disabled="@(_renovandoToken || string.IsNullOrWhiteSpace(_novoToken))">
                @(_renovandoToken ? "A guardar…" : "Guardar token")
            </button>
            @if (_tokenOk == true)
            {
                <span class="status-pill ok"><i class="fa-solid fa-check"></i> atualizado</span>
            }
            @if (_tokenOk == false)
            {
                <span class="status-pill erro"><i class="fa-solid fa-xmark"></i> falhou</span>
            }
        </div>
    </section>
</aside>

@* ============ VISÃO GERAL (treino × semana) ============ *@
<div class="visao-backdrop @(_visaoAberta ? "aberto" : "")" @onclick="FecharVisaoGeral"></div>
<div class="visao-modal @(_visaoAberta ? "aberto" : "")">
    <div class="visao-head">
        <h3>Visão geral — todas as semanas</h3>
        <button class="drawer-close" style="position:static" @onclick="FecharVisaoGeral"><i class="fa-solid fa-xmark"></i></button>
    </div>

    @if (_visaoCarregando)
    {
        <div class="cta-spinner" style="margin:40px auto"></div>
    }
    else if (_visaoErro is not null)
    {
        <p class="erro-inline" style="padding:0 22px 22px">@_visaoErro</p>
    }
    else if (_visaoGeral is not null)
    {
        <div class="visao-scroll">
            <table class="visao-tabela">
                <thead>
                    <tr>
                        <th></th>
                        @for (int s = 1; s <= _visaoGeral.SemanaAtual; s++)
                        {
                            var semana = s;
                            var atual = semana == _visaoGeral.SemanaAtual;
                            <th id="@(atual ? "visao-semana-atual" : null)" class="@(atual ? "atual" : "")">S@(semana)</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var treino in _visaoGeral.Treinos)
                    {
                        <tr>
                            <td class="visao-td-treino" title="@treino.Nome">@Letra(treino.Nome)</td>
                            @for (int s = 1; s <= treino.Preenchida.Count; s++)
                            {
                                var semana = s;
                                var preenchida = treino.Preenchida[semana - 1];
                                var aResincronizar = _resyncTreino == treino.Nome && _resyncSemana == semana;
                                <td>
                                    <button class="visao-cell @(preenchida ? "preenchida" : "vazia") @(aResincronizar ? "a-resync" : "")"
                                            disabled="@(!preenchida || _ocupado)"
                                            title="@(preenchida ? $"Rever/reenviar {treino.Nome} (semana {semana})" : "")"
                                            @onclick="() => PedirResyncAsync(treino.Nome, semana)">
                                        @if (aResincronizar && _resyncCarregando)
                                        {
                                            <span class="mini-spin"></span>
                                        }
                                        else if (preenchida)
                                        {
                                            <span><i class="fa-solid fa-check"></i></span>
                                        }
                                    </button>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (_resyncErro is not null)
        {
            <p class="erro-inline" style="padding:0 22px 18px">@_resyncErro</p>
        }

        @if (_resyncPreview is not null)
        {
            <div class="resync-confirm">
                <PreviewTreinoCard Preview="_resyncPreview" MostrarAvisos="false"
                                   Meta="@($"Vai reescrever com o treino de {FormatarData(_resyncPreview.DataLyfta)}.")" />
                <div class="confirm-actions">
                    <button class="btn btn-ghost" @onclick="CancelarResync" disabled="@_ocupado">Cancelar</button>
                    <button class="btn btn-primario" @onclick="ConfirmarResyncAsync" disabled="@_ocupado">Confirmar reenvio</button>
                </div>
            </div>
        }
    }
</div>
