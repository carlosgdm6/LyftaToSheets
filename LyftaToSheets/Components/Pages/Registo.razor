@page "/"
@using LyftaToSheets.Models
@using LyftaToSheets.Services
@inject ImportService Import
@inject MesocicloService Mesociclo
@inject LyftaTokenService LyftaToken
@inject ILogger<Registo> Log
@inject IJSRuntime JS
@rendermode InteractiveServer
@implements IAsyncDisposable

<PageTitle>LyftaSync</PageTitle>

<script>
    // Helper simples e global (não é module) só para centrar a coluna da semana atual
    // quando o modal "Visão geral" abre — chamado via JS interop a partir do bloco @@code.
    window.lyftaSyncFocar = function (id) {
        var el = document.getElementById(id);
        if (el) el.scrollIntoView({ inline: 'center', block: 'nearest' });
    };
</script>

<div class="top-actions">
    <button class="icon-btn visao-btn" title="Visão geral das semanas" @onclick="AbrirVisaoGeralAsync">▦</button>
    <button class="icon-btn gear-btn" title="Definições" @onclick="() => _definicoesAbertas = true">⚙</button>
</div>

@* ============ FLUXO — mantém-se visível do Hero até ao fim da sincronização ============ *@
@if (_fase is Fase.Hero or Fase.Sync or Fase.Erro)
{
    @if (_fase is Fase.Sync or Fase.Erro)
    {
        <div class="mini-title">⚡ Lyfta<span class="accent">Sync</span></div>
    }

    @if (_fase == Fase.Hero)
    {
        <div class="hero">
            <div class="hero-badge"><span class="dot"></span> Sincronização automática</div>
            <h1 class="hero-title">⚡ Lyfta<span class="accent">Sync</span></h1>
            <p class="hero-flowline">Lyfta <span class="arrow">→</span> Sheets</p>
            <p class="hero-sub">Os teus treinos. <strong>Organizados automaticamente.</strong></p>

            <div class="cta-wrap">
                <button class="cta @(_ocupado ? "loading" : "")" @onclick="IniciarAsync" disabled="@_ocupado">
                    @if (_ocupado)
                    {
                        <span class="cta-spinner"></span>
                        <span>A ligar…</span>
                    }
                    else
                    {
                        <span class="ico">@(_temTokenGuardado ? "⚡" : "🔗")</span>
                        <span>@(_temTokenGuardado ? "Sincronizar" : "Ligar ao Google")</span>
                    }
                </button>
                @if (!_temTokenGuardado && !_ocupado)
                {
                    <span class="cta-hint">Abre a tua conta Google só para escrever na folha do coach.</span>
                }
            </div>
        </div>
    }

    <div class="flow">
        <div class="flow-node @NodeClass(0)">
            <div class="orb">🏋️</div>
            <div class="label">Lyfta</div>
            <div class="status">@NodeStatus(0)</div>
        </div>
        <div class="flow-connector @ConnectorClass(0)"><div class="fill"></div><div class="dot"></div><div class="dot"></div><div class="dot"></div></div>
        <div class="flow-node @NodeClass(1)">
            <div class="orb">⚡</div>
            <div class="label">LyftaSync</div>
            <div class="status">@NodeStatus(1)</div>
        </div>
        <div class="flow-connector @ConnectorClass(1)"><div class="fill"></div><div class="dot"></div><div class="dot"></div><div class="dot"></div></div>
        <div class="flow-node @NodeClass(2)">
            <div class="orb">▦</div>
            <div class="label">Sheets</div>
            <div class="status">@NodeStatus(2)</div>
        </div>
    </div>
}

@* ============ NARRADOR — os 6 passos da sincronização ============ *@
@if (_fase == Fase.Sync && _passo is >= 0 and <= 4)
{
    <div class="sync-stage">
        <div class="steps">
            @for (int i = 0; i <= 4; i++)
            {
                var idx = i;
                <div class="step @PassoEstado(idx)">
                    <div class="step-num">@(PassoEstado(idx) == "done" ? "✓" : (idx + 1).ToString("00"))</div>
                    <div class="step-body">
                        <div class="step-title">@Passos[idx].titulo</div>
                        @if (PassoEstado(idx) == "active")
                        {
                            <div class="step-detail">@Passos[idx].detalhe</div>

                            @if (idx == 1 && _chipsExercicios.Count > 0)
                            {
                                <div class="chip-field">
                                    @foreach (var ex in _chipsExercicios)
                                    {
                                        <span class="chip">@ex</span>
                                    }
                                </div>
                            }

                            @if (idx == 2 && _previews is not null)
                            {
                                <div class="grupo-field">
                                    @foreach (var p in _previews)
                                    {
                                        <span class="grupo-pill">@p.Nome <span class="n">· @p.Linhas.Count ex.</span></span>
                                    }
                                </div>
                            }

                            @if (idx == 3 && _previews is not null)
                            {
                                <div class="semanas-field">
                                    @foreach (var p in _previews)
                                    {
                                        <div class="semana-strip">
                                            @foreach (var par in SemanaStrip(p.Semana))
                                            {
                                                <span class="semana-pill @(par.alvo ? "alvo" : "")">S@(par.semana)</span>
                                                @if (!par.alvo)
                                                {
                                                    <span class="semana-arrow">→</span>
                                                }
                                            }
                                        </div>
                                    }
                                </div>
                            }

                            @if (idx == 4 && _previews is not null)
                            {
                                <div class="sheet-window">
                                    <div class="sheet-titlebar">
                                        <span class="tdot"></span><span class="tdot"></span><span class="tdot"></span>
                                        <span class="tname">MESOCICLO 1 — Google Sheets</span>
                                    </div>
                                    @for (int pi = 0; pi < _previews.Count; pi++)
                                    {
                                        var p = _previews[pi];
                                        var ativa = _aGravarIndice == pi;
                                        var gravado = _gravados.Contains(p.Nome);
                                        <div class="sheet-group-title">@p.Nome → Semana @p.Semana</div>
                                        @foreach (var l in p.Linhas)
                                        {
                                            <div class="sheet-row @(ativa ? "ativa" : "")">
                                                <div class="sheet-cell">@l.ExercicioFolha</div>
                                                <div class="sheet-cell val">
                                                    @if (gravado || ativa)
                                                    {
                                                        <span class="typing">@l.Valor</span>
                                                    }
                                                </div>
                                                <div class="sheet-check">
                                                    @if (gravado)
                                                    {
                                                        <span class="ok">✓</span>
                                                    }
                                                    else if (ativa)
                                                    {
                                                        <span class="mini-spin"></span>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    }
                                </div>
                            }
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}

@* ============ SUCESSO ============ *@
@if (_fase == Fase.Sync && _passo == 5)
{
    <div class="sucesso">
        <div class="sucesso-ring"><div class="sucesso-check">✓</div></div>
        @if (_previews is { Count: 0 })
        {
            <h2>Tudo em dia.</h2>
            <p>Não havia treinos novos por sincronizar.</p>
        }
        else if (_previews is not null)
        {
            <h2>Está feito.</h2>
            <p>@_previews.Count treino@(_previews.Count == 1 ? "" : "s") sincronizado@(_previews.Count == 1 ? "" : "s").</p>
            <span class="semana-tag">Semana @_previews.Max(p => p.Semana)</span>
        }
    </div>
}

@* ============ ERRO ============ *@
@if (_fase == Fase.Erro)
{
    <div class="erro-card">
        <div class="erro-ico">⚠</div>
        <h3>Não foi possível sincronizar</h3>
        <p>@_erro</p>
        <button class="btn btn-primario" @onclick="TentarNovamente">Tentar novamente</button>
    </div>
}

@* ============ DASHBOARD ============ *@
@if (_fase == Fase.Dashboard)
{
    <div class="dash-top">
        <h1>Tudo sincronizado.</h1>
        <div class="quando"><span class="dot">●</span> Última sincronização · @TempoDesde()</div>
    </div>

    <div class="stat-grid">
        <div class="stat-tile">
            <div class="stat-num">@_treinosSincronizadosSessao</div>
            <div class="stat-label">Treinos sincronizados</div>
        </div>
        <div class="stat-tile">
            <div class="stat-num">@_semanaMaisAlta</div>
            <div class="stat-label">Semanas preenchidas</div>
        </div>
        <div class="stat-tile">
            <div class="stat-num check">✓</div>
            <div class="stat-label">Google ligado</div>
        </div>
    </div>

    <div class="next-card">
        @if (_aCarregarProxima)
        {
            <div class="cta-spinner" style="margin:0 auto"></div>
        }
        else if (_proximaPrevia is { Count: > 0 })
        {
            <div class="kicker">Próxima sincronização</div>
            <h3>Semana @_proximaPrevia.Min(p => p.Semana)</h3>
            <p>@_proximaPrevia.Count treino@(_proximaPrevia.Count == 1 ? "" : "s") pronto@(_proximaPrevia.Count == 1 ? "" : "s")</p>
            <button class="btn btn-primario" @onclick="SincronizarDeNovoAsync">Sincronizar agora</button>
        }
        else
        {
            <span class="vazio-icon">✅</span>
            <h3>Tudo em dia</h3>
            <p>Faz o próximo treino no Lyfta e volta aqui.</p>
            <button class="btn btn-ghost" @onclick="SincronizarDeNovoAsync">Verificar de novo</button>
        }
    </div>
}

@* ============ DRAWER DE DEFINIÇÕES ============ *@
<div class="drawer-backdrop @(_definicoesAbertas ? "aberto" : "")" @onclick="() => _definicoesAbertas = false"></div>
<aside class="drawer @(_definicoesAbertas ? "aberto" : "")">
    <button class="drawer-close" @onclick="() => _definicoesAbertas = false">✕</button>

    <h3>Ligação ao Google</h3>
    <div class="drawer-row">
        <button class="btn btn-ghost" @onclick="TestarGoogleAsync" disabled="@_testandoGoogle">
            @(_testandoGoogle ? "A testar…" : "Testar ligação")
        </button>
        @if (_googleTesteOk == true)
        {
            <span class="ok-inline">✓ ligado</span>
        }
        @if (_googleTesteOk == false)
        {
            <span class="erro-inline">✗ falhou</span>
        }
    </div>

    <h3>Token da API do Lyfta</h3>
    <a class="btn btn-ghost" href="https://my.lyfta.app/community/api" target="_blank" rel="noopener noreferrer">
        Obter token no Lyfta ↗
    </a>
    <input class="token-input" type="text" placeholder="Cola aqui o novo token" @bind="_novoToken" @bind:event="oninput" />
    <div class="drawer-row" style="margin-top:10px">
        <button class="btn btn-primario" @onclick="RenovarTokenAsync" disabled="@(_renovandoToken || string.IsNullOrWhiteSpace(_novoToken))">
            @(_renovandoToken ? "A guardar…" : "Guardar token")
        </button>
        @if (_tokenOk == true)
        {
            <span class="ok-inline">✓ atualizado</span>
        }
        @if (_tokenOk == false)
        {
            <span class="erro-inline">✗ falhou</span>
        }
    </div>
</aside>

@* ============ VISÃO GERAL (treino × semana) ============ *@
<div class="visao-backdrop @(_visaoAberta ? "aberto" : "")" @onclick="FecharVisaoGeral"></div>
<div class="visao-modal @(_visaoAberta ? "aberto" : "")">
    <div class="visao-head">
        <h3>Visão geral — todas as semanas</h3>
        <button class="drawer-close" style="position:static" @onclick="FecharVisaoGeral">✕</button>
    </div>

    @if (_visaoCarregando)
    {
        <div class="cta-spinner" style="margin:40px auto"></div>
    }
    else if (_visaoErro is not null)
    {
        <p class="erro-inline" style="padding:0 22px 22px">@_visaoErro</p>
    }
    else if (_visaoGeral is not null)
    {
        <div class="visao-scroll">
            <table class="visao-tabela">
                <thead>
                    <tr>
                        <th></th>
                        @for (int s = 1; s <= _visaoGeral.SemanaAtual; s++)
                        {
                            var semana = s;
                            var atual = semana == _visaoGeral.SemanaAtual;
                            <th id="@(atual ? "visao-semana-atual" : null)" class="@(atual ? "atual" : "")">S@semana</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var treino in _visaoGeral.Treinos)
                    {
                        <tr>
                            <td class="visao-td-treino" title="@treino.Nome">@Letra(treino.Nome)</td>
                            @for (int s = 1; s <= treino.Preenchida.Count; s++)
                            {
                                var semana = s;
                                var preenchida = treino.Preenchida[semana - 1];
                                var aResincronizar = _resyncTreino == treino.Nome && _resyncSemana == semana;
                                <td>
                                    <button class="visao-cell @(preenchida ? "preenchida" : "vazia") @(aResincronizar ? "a-resync" : "")"
                                            disabled="@(!preenchida || _ocupado)"
                                            title="@(preenchida ? $"Sincronizar {treino.Nome} outra vez (semana {semana})" : "")"
                                            @onclick="() => ResincronizarAsync(treino.Nome, semana)">
                                        @if (aResincronizar)
                                        {
                                            <span class="mini-spin"></span>
                                        }
                                        else if (preenchida)
                                        {
                                            <span>✓</span>
                                        }
                                    </button>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (_resyncErro is not null)
        {
            <p class="erro-inline" style="padding:0 22px 18px">@_resyncErro</p>
        }
    }
</div>
