@page "/"
@using LyftaToSheets.Models
@using LyftaToSheets.Services
@inject ImportService Import
@inject MesocicloService Mesociclo
@inject LyftaTokenService LyftaToken
@inject ILogger<Registo> Log
@inject IJSRuntime JS
@rendermode InteractiveServer
@implements IAsyncDisposable

<PageTitle>LyftaSync</PageTitle>

<button class="gear-btn" title="Definições" @onclick="() => _definicoesAbertas = true">⚙</button>

@* ============ FLUXO — mantém-se visível do Hero até ao fim da sincronização ============ *@
@if (_fase is Fase.Hero or Fase.Sync or Fase.Erro)
{
    @if (_fase is Fase.Sync or Fase.Erro)
    {
        <div class="mini-title">⚡ Lyfta<span class="accent">Sync</span></div>
    }

    @if (_fase == Fase.Hero)
    {
        <div class="hero">
            <div class="hero-badge"><span class="dot"></span> Sincronização automática</div>
            <h1 class="hero-title">⚡ Lyfta<span class="accent">Sync</span></h1>
            <p class="hero-flowline">Lyfta <span class="arrow">→</span> Sheets</p>
            <p class="hero-sub">Os teus treinos. <strong>Organizados automaticamente.</strong></p>

            <div class="cta-wrap">
                <button class="cta @(_ocupado ? "loading" : "")" @onclick="IniciarAsync" disabled="@_ocupado">
                    @if (_ocupado)
                    {
                        <span class="cta-spinner"></span>
                        <span>A ligar…</span>
                    }
                    else
                    {
                        <span class="ico">@(_temTokenGuardado ? "⚡" : "🔗")</span>
                        <span>@(_temTokenGuardado ? "Sincronizar" : "Ligar ao Google")</span>
                    }
                </button>
                @if (!_temTokenGuardado && !_ocupado)
                {
                    <span class="cta-hint">Abre a tua conta Google só para escrever na folha do coach.</span>
                }
            </div>
        </div>
    }

    <div class="flow">
        <div class="flow-node @NodeClass(0)">
            <div class="orb">🏋️</div>
            <div class="label">Lyfta</div>
            <div class="status">@NodeStatus(0)</div>
        </div>
        <div class="flow-connector @ConnectorClass(0)"><div class="fill"></div><div class="dot"></div><div class="dot"></div><div class="dot"></div></div>
        <div class="flow-node @NodeClass(1)">
            <div class="orb">⚡</div>
            <div class="label">LyftaSync</div>
            <div class="status">@NodeStatus(1)</div>
        </div>
        <div class="flow-connector @ConnectorClass(1)"><div class="fill"></div><div class="dot"></div><div class="dot"></div><div class="dot"></div></div>
        <div class="flow-node @NodeClass(2)">
            <div class="orb">▦</div>
            <div class="label">Sheets</div>
            <div class="status">@NodeStatus(2)</div>
        </div>
    </div>
}

@* ============ NARRADOR — os 6 passos da sincronização ============ *@
@if (_fase == Fase.Sync && _passo is >= 0 and <= 4)
{
    <div class="sync-stage">
        <div class="steps">
            @for (int i = 0; i <= 4; i++)
            {
                var idx = i;
                <div class="step @PassoEstado(idx)">
                    <div class="step-num">@(PassoEstado(idx) == "done" ? "✓" : (idx + 1).ToString("00"))</div>
                    <div class="step-body">
                        <div class="step-title">@Passos[idx].titulo</div>
                        @if (PassoEstado(idx) == "active")
                        {
                            <div class="step-detail">@Passos[idx].detalhe</div>

                            @if (idx == 1 && _chipsExercicios.Count > 0)
                            {
                                <div class="chip-field">
                                    @foreach (var ex in _chipsExercicios)
                                    {
                                        <span class="chip">@ex</span>
                                    }
                                </div>
                            }

                            @if (idx == 2 && _previews is not null)
                            {
                                <div class="grupo-field">
                                    @foreach (var p in _previews)
                                    {
                                        <span class="grupo-pill">@p.Nome <span class="n">· @p.Linhas.Count ex.</span></span>
                                    }
                                </div>
                            }

                            @if (idx == 3 && _previews is not null)
                            {
                                <div class="semanas-field">
                                    @foreach (var p in _previews)
                                    {
                                        <div class="semana-strip">
                                            @foreach (var par in SemanaStrip(p.Semana))
                                            {
                                                <span class="semana-pill @(par.alvo ? "alvo" : "")">S@(par.semana)</span>
                                                @if (!par.alvo)
                                                {
                                                    <span class="semana-arrow">→</span>
                                                }
                                            }
                                        </div>
                                    }
                                </div>
                            }

                            @if (idx == 4 && _previews is not null)
                            {
                                <div class="sheet-window">
                                    <div class="sheet-titlebar">
                                        <span class="tdot"></span><span class="tdot"></span><span class="tdot"></span>
                                        <span class="tname">MESOCICLO 1 — Google Sheets</span>
                                    </div>
                                    @for (int pi = 0; pi < _previews.Count; pi++)
                                    {
                                        var p = _previews[pi];
                                        var ativa = _aGravarIndice == pi;
                                        var gravado = _gravados.Contains(p.Nome);
                                        <div class="sheet-group-title">@p.Nome → Semana @p.Semana</div>
                                        @foreach (var l in p.Linhas)
                                        {
                                            <div class="sheet-row @(ativa ? "ativa" : "")">
                                                <div class="sheet-cell">@l.ExercicioFolha</div>
                                                <div class="sheet-cell val">
                                                    @if (gravado || ativa)
                                                    {
                                                        <span class="typing">@l.Valor</span>
                                                    }
                                                </div>
                                                <div class="sheet-check">
                                                    @if (gravado)
                                                    {
                                                        <span class="ok">✓</span>
                                                    }
                                                    else if (ativa)
                                                    {
                                                        <span class="mini-spin"></span>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    }
                                </div>
                            }
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}

@* ============ SUCESSO ============ *@
@if (_fase == Fase.Sync && _passo == 5)
{
    <div class="sucesso">
        <div class="sucesso-ring"><div class="sucesso-check">✓</div></div>
        @if (_previews is { Count: 0 })
        {
            <h2>Tudo em dia.</h2>
            <p>Não havia treinos novos por sincronizar.</p>
        }
        else if (_previews is not null)
        {
            <h2>Está feito.</h2>
            <p>@_previews.Count treino@(_previews.Count == 1 ? "" : "s") sincronizado@(_previews.Count == 1 ? "" : "s").</p>
            <span class="semana-tag">Semana @_previews.Max(p => p.Semana)</span>
        }
    </div>
}

@* ============ ERRO ============ *@
@if (_fase == Fase.Erro)
{
    <div class="erro-card">
        <div class="erro-ico">⚠</div>
        <h3>Não foi possível sincronizar</h3>
        <p>@_erro</p>
        <button class="btn btn-primario" @onclick="TentarNovamente">Tentar novamente</button>
    </div>
}

@* ============ DASHBOARD ============ *@
@if (_fase == Fase.Dashboard)
{
    <div class="dash-top">
        <h1>Tudo sincronizado.</h1>
        <div class="quando"><span class="dot">●</span> Última sincronização · @TempoDesde()</div>
    </div>

    <div class="stat-grid">
        <div class="stat-tile">
            <div class="stat-num">@_treinosSincronizadosSessao</div>
            <div class="stat-label">Treinos sincronizados</div>
        </div>
        <div class="stat-tile">
            <div class="stat-num">@_semanaMaisAlta</div>
            <div class="stat-label">Semanas preenchidas</div>
        </div>
        <div class="stat-tile">
            <div class="stat-num check">✓</div>
            <div class="stat-label">Google ligado</div>
        </div>
    </div>

    <div class="next-card">
        @if (_aCarregarProxima)
        {
            <div class="cta-spinner" style="margin:0 auto"></div>
        }
        else if (_proximaPrevia is { Count: > 0 })
        {
            <div class="kicker">Próxima sincronização</div>
            <h3>Semana @_proximaPrevia.Min(p => p.Semana)</h3>
            <p>@_proximaPrevia.Count treino@(_proximaPrevia.Count == 1 ? "" : "s") pronto@(_proximaPrevia.Count == 1 ? "" : "s")</p>
            <button class="btn btn-primario" @onclick="SincronizarDeNovoAsync">Sincronizar agora</button>
        }
        else
        {
            <span class="vazio-icon">✅</span>
            <h3>Tudo em dia</h3>
            <p>Faz o próximo treino no Lyfta e volta aqui.</p>
            <button class="btn btn-ghost" @onclick="SincronizarDeNovoAsync">Verificar de novo</button>
        }
    </div>
}

@* ============ DRAWER DE DEFINIÇÕES ============ *@
<div class="drawer-backdrop @(_definicoesAbertas ? "aberto" : "")" @onclick="() => _definicoesAbertas = false"></div>
<aside class="drawer @(_definicoesAbertas ? "aberto" : "")">
    <button class="drawer-close" @onclick="() => _definicoesAbertas = false">✕</button>

    <h3>Ligação ao Google</h3>
    <div class="drawer-row">
        <button class="btn btn-ghost" @onclick="TestarGoogleAsync" disabled="@_testandoGoogle">
            @(_testandoGoogle ? "A testar…" : "Testar ligação")
        </button>
        @if (_googleTesteOk == true)
        {
            <span class="ok-inline">✓ ligado</span>
        }
        @if (_googleTesteOk == false)
        {
            <span class="erro-inline">✗ falhou</span>
        }
    </div>

    <h3>Token da API do Lyfta</h3>
    <a class="btn btn-ghost" href="https://my.lyfta.app/community/api" target="_blank" rel="noopener noreferrer">
        Obter token no Lyfta ↗
    </a>
    <input class="token-input" type="text" placeholder="Cola aqui o novo token" @bind="_novoToken" @bind:event="oninput" />
    <div class="drawer-row" style="margin-top:10px">
        <button class="btn btn-primario" @onclick="RenovarTokenAsync" disabled="@(_renovandoToken || string.IsNullOrWhiteSpace(_novoToken))">
            @(_renovandoToken ? "A guardar…" : "Guardar token")
        </button>
        @if (_tokenOk == true)
        {
            <span class="ok-inline">✓ atualizado</span>
        }
        @if (_tokenOk == false)
        {
            <span class="erro-inline">✗ falhou</span>
        }
    </div>
</aside>

@code {
    private enum Fase { Hero, Sync, Dashboard, Erro }

    private static readonly (string titulo, string detalhe)[] Passos =
    [
        ("A ligar ao Lyfta", "A ir buscar os teus treinos mais recentes."),
        ("A procurar os teus treinos", "A identificar os exercícios de cada treino."),
        ("A organizar os dados", "A encaixar os exercícios nos blocos da folha."),
        ("A procurar uma semana livre", "A folha nunca é sobrescrita — só a próxima semana vazia."),
        ("A enviar para o Google Sheets", "A escrever os valores, treino a treino."),
    ];

    private Fase _fase = Fase.Hero;
    private bool _temTokenGuardado;
    private bool _ocupado;
    private int _passo;
    private string? _erro;
    private IReadOnlyList<TreinoPreview>? _previews;
    private readonly HashSet<string> _gravados = new();
    private int _aGravarIndice = -1;
    private List<string> _chipsExercicios = new();

    private int _treinosSincronizadosSessao;
    private int _semanaMaisAlta;
    private DateTime? _ultimaSincronizacao;
    private IReadOnlyList<TreinoPreview>? _proximaPrevia;
    private bool _aCarregarProxima;
    private System.Threading.Timer? _relogio;

    private bool _definicoesAbertas;
    private bool _testandoGoogle;
    private bool? _googleTesteOk;
    private string _novoToken = "";
    private bool _renovandoToken;
    private bool? _tokenOk;

    protected override void OnInitialized()
    {
        _temTokenGuardado = Mesociclo.TemTokenGuardado();
        _relogio = new System.Threading.Timer(_ => InvokeAsync(StateHasChanged), null, 20_000, 20_000);
    }

    public ValueTask DisposeAsync()
    {
        _relogio?.Dispose();
        return ValueTask.CompletedTask;
    }

    /// <summary>Escreve na consola do BROWSER (F12), não na consola do servidor — para se
    /// conseguir ver o que se passa a partir do próprio browser, ao lado do resto dos logs.</summary>
    private async Task ConsolaAsync(string mensagem, object? dados = null)
    {
        try
        {
            if (dados is null)
                await JS.InvokeVoidAsync("console.log", $"[LyftaSync] {mensagem}");
            else
                await JS.InvokeVoidAsync("console.log", $"[LyftaSync] {mensagem}", dados);
        }
        catch
        {
            // O circuito pode já não estar ligado (ex: página a fechar) — não é um erro a reportar.
        }
    }

    private async Task ConsolaErroAsync(string mensagem, Exception ex)
    {
        try { await JS.InvokeVoidAsync("console.error", $"[LyftaSync] {mensagem}", ex.ToString()); }
        catch { }
    }

    private string PassoEstado(int i) => i < _passo ? "done" : i == _passo ? "active" : "pending";

    private static IEnumerable<(int semana, bool alvo)> SemanaStrip(int alvo)
    {
        int inicio = Math.Max(1, alvo - 2);
        for (int s = inicio; s <= alvo; s++) yield return (s, s == alvo);
    }

    private string NodeClass(int idxNode)
    {
        if (_fase != Fase.Sync) return "";
        bool active = idxNode switch
        {
            0 => _passo is -1 or 0,
            1 => _passo is 1 or 2 or 3,
            2 => _passo == 4,
            _ => false
        };
        bool done = idxNode switch
        {
            0 => _passo >= 1,
            1 => _passo >= 4,
            2 => _passo >= 5,
            _ => false
        };
        return active ? "active" : done ? "done" : "";
    }

    private string NodeStatus(int idxNode)
    {
        if (_fase != Fase.Sync) return "";
        return idxNode switch
        {
            0 => _passo == -1 ? "" : _passo == 0 ? "a ligar…" : _passo >= 1 ? "treinos encontrados" : "",
            1 => _passo == -1 ? "a ligar ao Google…" : _passo is 1 or 2 or 3 ? "a processar…" : _passo >= 4 ? "processado" : "",
            2 => _passo == 4 ? "a escrever…" : _passo >= 5 ? "atualizado" : "",
            _ => ""
        };
    }

    private string ConnectorClass(int idx)
    {
        if (_fase != Fase.Sync) return "";
        bool active = idx == 0 ? _passo == 0 : _passo == 4;
        bool done = idx == 0 ? _passo >= 1 : _passo >= 5;
        return active ? "active" : done ? "done" : "";
    }

    private string TempoDesde()
    {
        if (_ultimaSincronizacao is null) return "agora mesmo";
        var delta = DateTime.Now - _ultimaSincronizacao.Value;
        if (delta.TotalSeconds < 45) return "agora mesmo";
        if (delta.TotalMinutes < 2) return "há 1 minuto";
        if (delta.TotalMinutes < 60) return $"há {(int)delta.TotalMinutes} minutos";
        if (delta.TotalHours < 2) return "há 1 hora";
        return $"há {(int)delta.TotalHours} horas";
    }

    private async Task IniciarAsync()
    {
        if (_ocupado) return;
        _ocupado = true;
        _erro = null;
        _fase = Fase.Sync;
        _passo = -1;
        StateHasChanged();
        await ConsolaAsync("A iniciar sincronização...");

        if (!_temTokenGuardado)
        {
            try
            {
                await Mesociclo.TestarLigacaoAsync();
                _temTokenGuardado = true;
                await ConsolaAsync("Ligação ao Google estabelecida.");
            }
            catch (Exception ex)
            {
                await ConsolaErroAsync("Falha ao ligar ao Google", ex);
                _erro = "Não foi possível ligar ao Google. " + ex.Message;
                _fase = Fase.Erro;
                _ocupado = false;
                return;
            }
        }

        await ExecutarSincronizacaoAsync();
        _ocupado = false;
    }

    private async Task SincronizarDeNovoAsync()
    {
        if (_ocupado) return;
        _ocupado = true;
        _fase = Fase.Sync;
        StateHasChanged();
        await ExecutarSincronizacaoAsync();
        _ocupado = false;
    }

    private async Task ExecutarSincronizacaoAsync()
    {
        _passo = 0;
        _previews = null;
        _chipsExercicios.Clear();
        _gravados.Clear();
        _aGravarIndice = -1;
        StateHasChanged();

        IReadOnlyList<TreinoPreview> previews;
        try
        {
            previews = await Import.GerarPreviewAsync();
        }
        catch (Exception ex)
        {
            await ConsolaErroAsync("Falha ao gerar a pré-visualização", ex);
            _erro = ex.Message;
            _fase = Fase.Erro;
            return;
        }
        _previews = previews;
        await ConsolaAsync($"{previews.Count} proposta(s) de treino geradas.");

        if (previews.Count == 0)
        {
            _passo = 5;
            StateHasChanged();
            await Task.Delay(500);
            await EntrarDashboardAsync(0);
            return;
        }

        _chipsExercicios = previews.SelectMany(p => p.Linhas.Select(l => l.ExercicioLyfta)).Distinct().Take(10).ToList();
        _passo = 1; StateHasChanged(); await Task.Delay(750);

        _passo = 2; StateHasChanged(); await Task.Delay(700);

        _passo = 3; StateHasChanged(); await Task.Delay(850);

        _passo = 4; StateHasChanged();
        int gravadosAgora = 0;
        for (int i = 0; i < previews.Count; i++)
        {
            var p = previews[i];
            _aGravarIndice = i;
            StateHasChanged();
            try
            {
                await Import.GravarAsync(p);
                _gravados.Add(p.Nome);
                _semanaMaisAlta = Math.Max(_semanaMaisAlta, p.Semana);
                gravadosAgora++;
                await ConsolaAsync($"Gravado: {p.Nome} (semana {p.Semana}).");
            }
            catch (Exception ex)
            {
                await ConsolaErroAsync($"Falha ao gravar {p.Nome}", ex);
                _aGravarIndice = -1;
                _erro = gravadosAgora > 0
                    ? $"{gravadosAgora} de {previews.Count} treinos foram gravados antes de um erro. {ex.Message}"
                    : ex.Message;
                _fase = Fase.Erro;
                return;
            }
            StateHasChanged();
            await Task.Delay(320);
        }
        _aGravarIndice = -1;

        _passo = 5;
        StateHasChanged();
        await ConsolaAsync($"Sincronização concluída: {gravadosAgora} treino(s) gravado(s).");
        await Task.Delay(1100);
        await EntrarDashboardAsync(gravadosAgora);
    }

    private async Task EntrarDashboardAsync(int gravadosAgora)
    {
        _treinosSincronizadosSessao += gravadosAgora;
        _ultimaSincronizacao = DateTime.Now;
        _fase = Fase.Dashboard;
        _aCarregarProxima = true;
        StateHasChanged();

        try { _proximaPrevia = await Import.GerarPreviewAsync(); }
        catch (Exception ex)
        {
            Log.LogWarning(ex, "Não foi possível carregar a próxima pré-visualização.");
            await ConsolaErroAsync("Não foi possível carregar a próxima pré-visualização", ex);
            _proximaPrevia = null;
        }
        _aCarregarProxima = false;
        StateHasChanged();
    }

    private void TentarNovamente()
    {
        _erro = null;
        _fase = _ultimaSincronizacao is not null ? Fase.Dashboard : Fase.Hero;
    }

    private async Task TestarGoogleAsync()
    {
        _testandoGoogle = true; _googleTesteOk = null;
        StateHasChanged();
        try
        {
            await Mesociclo.TestarLigacaoAsync();
            _googleTesteOk = true;
            _temTokenGuardado = true;
            await ConsolaAsync("Teste de ligação ao Google: OK.");
        }
        catch (Exception ex)
        {
            Log.LogWarning(ex, "Teste de ligação ao Google falhou.");
            await ConsolaErroAsync("Teste de ligação ao Google falhou", ex);
            _googleTesteOk = false;
        }
        finally { _testandoGoogle = false; }
    }

    private async Task RenovarTokenAsync()
    {
        _renovandoToken = true; _tokenOk = null;
        StateHasChanged();
        try
        {
            await LyftaToken.AtualizarAsync(_novoToken);
            _tokenOk = true;
            _novoToken = "";
            await ConsolaAsync("Token do Lyfta atualizado.");
        }
        catch (Exception ex)
        {
            Log.LogWarning(ex, "Atualização do token do Lyfta falhou.");
            await ConsolaErroAsync("Atualização do token do Lyfta falhou", ex);
            _tokenOk = false;
        }
        finally { _renovandoToken = false; }
    }
}
