    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["LyftaToSheets.styles.css"]" />
    <ImportMap />
    @* ?v=2 é só para forçar o browser a não usar o favicon antigo que já tinha em cache — os
       browsers guardam favicons de forma muito mais agressiva do que o resto da página, e muitas
       vezes nem um hard-refresh normal (Ctrl+Shift+R) os substitui sem isto. *@
    <link rel="icon" type="image/svg+xml" href="favicon.svg?v=2" />
    <link rel="alternate icon" href="favicon.png?v=2" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
